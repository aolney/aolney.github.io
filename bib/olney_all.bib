@InProceedings{Olney2021c,
  author    = {Olney, Andrew M.},
  booktitle = {Proceedings of the Eighth ACM Conference on Learning @ Scale},
  title     = {Generating Response-Specific Elaborated Feedback Using Long-Form Neural Question Answering},
  doi       = {10.1145/3430895.3460131},
